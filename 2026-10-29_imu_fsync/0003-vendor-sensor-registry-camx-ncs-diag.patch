diff --git a/camx/src/core/ncs/camxncsintfqsee.cpp b/camx/src/core/ncs/camxncsintfqsee.cpp
index 33cb7ffc..8a09279b 100755
--- a/camx/src/core/ncs/camxncsintfqsee.cpp
+++ b/camx/src/core/ncs/camxncsintfqsee.cpp
@@ -544,6 +544,33 @@ CamxResult NCSIntfQSEE::SendConfigRequest(
                         sensorType);
 
         m_sensorConnList[connIndex].suid = *pSUID;
+
+        // [CQ8750s] Clamp the requested sample rate to the max rate advertised by the sensor
+        // (SNS_STD_SENSOR_ATTRID_RATES). GME requests gyro_frequency from EIS chromatix (832Hz for
+        // sc5a0xs) or 960Hz default, but ICM42607 normal mode max ODR is 200Hz; the sensors PD
+        // rejects the config with SNS_STD_ERROR_INVALID_VALUE (error event 5) and the stream dies.
+        // Note: rates[] is copied verbatim from the SSC attribute in arrival order — not sorted,
+        // and may contain trailing zeros — so clamp to the largest non-zero advertised rate.
+        {
+            QSEESensorCap* pCap = &m_sensorInfo[sensorType].sensorCaps;
+            FLOAT maxRate = 0.0f;
+            for (UINT i = 0; i < pCap->numRates; i++)
+            {
+                if (pCap->rates[i] > maxRate)
+                {
+                    maxRate = pCap->rates[i];
+                }
+            }
+            if ((0 < maxRate) && (pSensorConfig->samplingRate > maxRate))
+            {
+                CAMX_LOG_ERROR(CamxLogGroupNCS, "Sensor %d: clamped sample rate %f -> %f (sensor max)",
+                              sensorType,
+                              pSensorConfig->samplingRate,
+                              maxRate);
+                pSensorConfig->samplingRate = maxRate;
+            }
+        }
+
         CAMX_LOG_CONFIG(CamxLogGroupNCS, "sensor type %d suidH 0x%x suidL 0x%x SampleRate %f ReportRate %d ",
                         pSensorConfig->sensorType,
                         pSUID->m_high,
