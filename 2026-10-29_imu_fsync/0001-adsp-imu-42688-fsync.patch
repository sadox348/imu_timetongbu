+#ifdef UGPIOINT_DIRCONN_SUPPORT
+/* =============================================================================
+**  Function : uGPIOIntInternal_ConfigDirConn
+** ===========================================================================*/
+/**
+  Fallback for GPIOs that cannot be configured at the PDC GPIO mux.
+  Claims a free TLMM DIR_CONN SENSORS slot and routes the GPIO raw
+  interrupt line to the dir_conn_irq_sensors PDC interrupt input.
+
+  The PDC interrupt input is NOT enabled here: pdcInt_enable() requires
+  pdcInt_config() to have run first (it validates drv_num in the PDC
+  interrupt table), which happens inside
+  InterruptController_RegisterInterrupt(). The caller enables the PDC
+  side once registration has succeeded.
+
+  @param[in]  nGpio     GPIO number
+  @param[out] pnInt     Subsystem interrupt vector (41 + slot)
+
+  @return
+  UGPIOINT_SUCCESS -- Successfully configured DIR_CONN
+  UGPIOINT_ERROR -- No free DIR_CONN SENSORS slot
+
+  @dependencies
+  None.
+*/
+
+static int32_t uGPIOIntInternal_ConfigDirConn
+(
+  uint32_t  nGpio,
+  uint32_t *pnInt
+)
+{
+  uintptr_t nAddr;
+  uint32_t  nPage = 0, nVal;
+  uint32_t  nSlot;
+
+  for (nSlot = 0; nSlot < UGPIOINT_DIRCONN_NUM_SLOTS; nSlot++)
+  {
+    if (UGPIOINT_DIRCONN_SLOT_FREE == uGPIOIntDirConnSlots[nSlot])
+    {
+      break;
+    }
+  }
+
+  if (UGPIOINT_DIRCONN_NUM_SLOTS == nSlot)
+  {
+    return UGPIOINT_ERROR;
+  }
+
+  nAddr = HWIO_TLMM_DIR_CONN_INTRn_CFG_SENSORS_ADDR(TLMM_REG_REG_BASE, nSlot);
+
+  /* Program page select since we're accessing external registers */
+  if (nAddr & 0x80000000)
+  {
+    nPage = HWIO_INF(SDC_PAGE_SELECT, DDR_PAGE_SELECT);
+    HWIO_OUTF(SDC_PAGE_SELECT, DDR_PAGE_SELECT, 0);
+  }
+
+  /*
+   * Connect the GPIO to the DIR_CONN slot. POLARITY is always 1: the
+   * line is consumed by the PDC interrupt input and the PDC performs
+   * the actual trigger detection.
+   */
+  HWIO_TLMM_DIR_CONN_INTRn_CFG_SENSORS_OUTI(
+    TLMM_REG_REG_BASE, nSlot,
+    (HWIO_TLMM_DIR_CONN_INTRn_CFG_SENSORS_GPIO_SEL_BMSK & nGpio) |
+      HWIO_TLMM_DIR_CONN_INTRn_CFG_SENSORS_POLARITY_BMSK);
+
+  /* Route the GPIO raw interrupt line to the DIR_CONN router */
+  nAddr = HWIO_ADDRX(
+            TLMM_REG_REG_BASE +
+              (nGpio * UGPIOINT_GPIO_OFFSET), TLMM_GPIO_INTR_CFG0);
+
+  nVal = in_dword(nAddr);
+
+  /* Configure WAKEUP_ENABLE if WAKEUP_PRESENT is 1, as in the PDC path */
+  if ((nVal & HWIO_TLMM_GPIO_INTR_CFG0_WAKEUP_PRESENT_BMSK) ==
+        HWIO_TLMM_GPIO_INTR_CFG0_WAKEUP_PRESENT_BMSK)
+  {
+    nVal |= HWIO_TLMM_GPIO_INTR_CFG0_WAKEUP_ENABLE_BMSK;
+  }
+
+  nVal |= HWIO_TLMM_GPIO_INTR_CFG0_DIR_CONN_EN_BMSK;
+  out_dword(nAddr, nVal);
+
+  /* Restore the page select config */
+  if (nAddr & 0x80000000)
+  {
+    HWIO_OUTF(SDC_PAGE_SELECT, DDR_PAGE_SELECT, nPage);
+  }
+
+  uGPIOIntDirConnSlots[nSlot] = nGpio;
+  uGPIOIntData.aState[UGPIOINT_IDX(nGpio)].nFlags |= UGPIOINTF_DIRCONN;
+
+  if (pnInt)
+  {
+    *pnInt = UGPIOINT_DIRCONN_VECTOR_BASE + nSlot;
+  }
+
+  return UGPIOINT_SUCCESS;
+}
+
+/* =============================================================================
+**  Function : uGPIOIntInternal_DeconfigDirConn
+** ===========================================================================*/
+/**
+  Releases a TLMM DIR_CONN SENSORS slot previously claimed by
+  uGPIOIntInternal_ConfigDirConn() and disables the corresponding PDC
+  interrupt input. No-op if the GPIO is not DIR_CONN-routed.
+
+  @param[in]  nGpio   GPIO number
+
+  @return
+  None.
+
+  @dependencies
+  None.
+*/
+
+static void uGPIOIntInternal_DeconfigDirConn
+(
+  uint32_t nGpio
+)
+{
+  uintptr_t nAddr;
+  uint32_t  nPage = 0, nVal;
+  uint32_t  nSlot;
+
+  for (nSlot = 0; nSlot < UGPIOINT_DIRCONN_NUM_SLOTS; nSlot++)
+  {
+    if (nGpio == uGPIOIntDirConnSlots[nSlot])
+    {
+      break;
+    }
+  }
+
+  if (UGPIOINT_DIRCONN_NUM_SLOTS == nSlot)
+  {
+    return;
+  }
+
+  nAddr = HWIO_TLMM_DIR_CONN_INTRn_CFG_SENSORS_ADDR(TLMM_REG_REG_BASE, nSlot);
+
+  /* Program page select since we're accessing external registers */
+  if (nAddr & 0x80000000)
+  {
+    nPage = HWIO_INF(SDC_PAGE_SELECT, DDR_PAGE_SELECT);
+    HWIO_OUTF(SDC_PAGE_SELECT, DDR_PAGE_SELECT, 0);
+  }
+
+  /* Disconnect the slot (GPIO_SEL=0 selects a GPIO that is not routed) */
+  HWIO_TLMM_DIR_CONN_INTRn_CFG_SENSORS_OUTI(TLMM_REG_REG_BASE, nSlot, 0);
+
+  /* Stop routing the GPIO raw interrupt line to the DIR_CONN router */
+  nVal = in_dword(HWIO_ADDRX(
+           TLMM_REG_REG_BASE +
+             (nGpio * UGPIOINT_GPIO_OFFSET), TLMM_GPIO_INTR_CFG0));
+  nVal &= ~HWIO_TLMM_GPIO_INTR_CFG0_DIR_CONN_EN_BMSK;
+  out_dword(HWIO_ADDRX(
+              TLMM_REG_REG_BASE +
+                (nGpio * UGPIOINT_GPIO_OFFSET), TLMM_GPIO_INTR_CFG0), nVal);
+
+  /* Restore the page select config */
+  if (nAddr & 0x80000000)
+  {
+    HWIO_OUTF(SDC_PAGE_SELECT, DDR_PAGE_SELECT, nPage);
+  }
+
+  /* Disable the PDC interrupt input (no-op if never enabled) */
+  pdcInt_disable(UGPIOINT_DIRCONN_VECTOR_BASE + nSlot);
+
+  uGPIOIntDirConnSlots[nSlot] = UGPIOINT_DIRCONN_SLOT_FREE;
+}
+#endif /* UGPIOINT_DIRCONN_SUPPORT */
+
