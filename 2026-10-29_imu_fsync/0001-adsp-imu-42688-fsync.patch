+/*==============================================================================
+  Data: DIR_CONN fallback
+================================================================================
+  [CQ8750s] Goertek: GPIOs absent from the PDC mux table (e.g. pakala GPIO206,
+  wired to ICM42607 INT1 on the sun board) cannot be delivered to a user PD
+  through the PDC path, since pdcGpio_config() only supports muxed GPIOs and
+  GPIOInt_DirConn.c is not linked into user images (gpioint.scons links only
+  uGPIOInt.c into USES_SENSOR_IMG). This fallback programs a TLMM direct
+  connect (DIR_CONN) slot locally when the PDC configuration fails, so the
+  interrupt still reaches this PD through one of the 6 direct-connect QURT
+  interrupt vectors. Mirrors GPIOInt_DirConn.c DirConnGpioInternal_Toggle /
+  SetDirConnIntrPolarity and the pakala GPIOIntBSP.c DirConnCfgMap.
+==============================================================================*/
+
+/* Direct-connect QURT interrupt vectors from pakala GPIOIntBSP.c DirConnCfgMap */
+#define UGPIOINT_DIRCONN_SLOTS        6
+
+typedef struct
+{
+  uint16_t nGpio;                    /* GPIO routed to this slot */
+  uint16_t nInt;                     /* QURT interrupt vector for this slot */
+  uint8_t  bActive;                  /* Slot in use */
+} uGPIOIntDirConnSlotType;
+
+static uGPIOIntDirConnSlotType uGPIOIntDirConnSlots[UGPIOINT_DIRCONN_SLOTS] =
+{
+  { UGPIOINT_NONE, 79,  0 },
+  { UGPIOINT_NONE, 86,  0 },
+  { UGPIOINT_NONE, 28,  0 },
+  { UGPIOINT_NONE, 66,  0 },
+  { UGPIOINT_NONE, 117, 0 },
+  { UGPIOINT_NONE, 130, 0 }
+};
+
 
