+/* =============================================================================
+**  Function : uGPIOIntInternal_DirConnConfig
+** ===========================================================================*/
+/**
+  [CQ8750s] Goertek: configures a TLMM direct-connect slot for a GPIO not
+  routed through PDC.
+
+  Mirrors GPIOInt_DirConn.c: routes the GPIO into a free DIR_CONN slot,
+  programs DET/POL for the requested trigger and enables the connection.
+  Returns the QURT interrupt vector for the slot so the existing
+  qurt_isr_register2()/qurt_interrupt_enable() paths keep working unchanged.
+
+  Dual-edge is not supported by the direct-connect hardware.
+
+  @param[in]  nGpio     GPIO number
+  @param[in]  eTrigger  Interrupt trigger at TLMM level
+  @param[out] pnInt     QURT interrupt vector assigned to this GPIO
+
+  @return
+  UGPIOINT_SUCCESS -- Slot configured
+  UGPIOINT_ERROR   -- No free slot or unsupported trigger
+
+  @dependencies
+  None.
+*/
+
+static int32_t uGPIOIntInternal_DirConnConfig
+(
+  uint32_t            nGpio,
+  uGPIOIntTriggerType eTrigger,
+  uint32_t           *pnInt
+)
+{
+  uint32_t nIdx;
+  uint32_t nPol = 1, nDet = 0;
+  uint32_t eHALResult;
+
+  if (UGPIOINT_TRIGGER_DUAL_EDGE == eTrigger)
+  {
+    uGPIOIntInternal_Log(
+      1, "%s: FAIL. DIR_CONN does not support dual edge (GPIO %d)",
+      __func__, nGpio);
+    return UGPIOINT_ERROR;
+  }
+
+  for (nIdx = 0; nIdx < UGPIOINT_DIRCONN_SLOTS; nIdx++)
+  {
+    if (!uGPIOIntDirConnSlots[nIdx].bActive)
+    {
+      break;
+    }
+  }
+  if (nIdx >= UGPIOINT_DIRCONN_SLOTS)
+  {
+    uGPIOIntInternal_Log(
+      1, "%s: FAIL. No free DIR_CONN slot (GPIO %d)", __func__, nGpio);
+    return UGPIOINT_ERROR;
+  }
+
+  /* Trigger to DET/POL, per GPIOInt_Summary.c SummaryGpioInternal_SetTrigger */
+  switch (eTrigger)
+  {
+    case UGPIOINT_TRIGGER_HIGH:
+      nPol = 1;
+      nDet = 0;
+      break;
+
+    case UGPIOINT_TRIGGER_LOW:
+      nPol = 0;
+      nDet = 0;
+      break;
+
+    case UGPIOINT_TRIGGER_RISING:
+      nPol = 1;
+      nDet = 1;
+      break;
+
+    case UGPIOINT_TRIGGER_FALLING:
+      nPol = 1;
+      nDet = 2;
+      break;
+
+    default:
+      nPol = 1;
+      nDet = 0;
+      break;
+  }
+
+  /* Select GPIO into the DIR_CONN slot and set polarity on the slot */
+  eHALResult = HAL_tlmmtile_SetDirConn(
+                 nIdx, HAL_TLMMTILE_FIELD_DIRCONNINTRCFG_SEL, nGpio);
+  if (HALTLMMTILE_ERR == eHALResult)
+  {
+    uGPIOIntInternal_Log(
+      1, "%s: FAIL. Could not set DIR_CONN %d SEL (GPIO %d)",
+      __func__, nIdx, nGpio);
+    return UGPIOINT_ERROR;
+  }
+
+  eHALResult = HAL_tlmmtile_SetDirConn(
+                 nIdx, HAL_TLMMTILE_FIELD_DIRCONNINTRCFG_POL, nPol);
+  if (HALTLMMTILE_ERR == eHALResult)
+  {
+    uGPIOIntInternal_Log(
+      1, "%s: FAIL. Could not set DIR_CONN %d POL (GPIO %d)",
+      __func__, nIdx, nGpio);
+    return UGPIOINT_ERROR;
+  }
+
+  /* Program DET/POL and enable direct-connect on the GPIO itself */
+  eHALResult = HAL_tlmmtile_Set(
+                 nGpio, HAL_TLMMTILE_REG_INTRCFG,
+                 HAL_TLMMTILE_FIELD_INTRCFG_DET, nDet);
+  if (HALTLMMTILE_ERR == eHALResult)
+  {
+    uGPIOIntInternal_Log(
+      1, "%s: FAIL. Could not set DET for GPIO %d", __func__, nGpio);
+    return UGPIOINT_ERROR;
+  }
+
+  eHALResult = HAL_tlmmtile_Set(
+                 nGpio, HAL_TLMMTILE_REG_INTRCFG,
+                 HAL_TLMMTILE_FIELD_INTRCFG_POL, nPol);
+  if (HALTLMMTILE_ERR == eHALResult)
+  {
+    uGPIOIntInternal_Log(
+      1, "%s: FAIL. Could not set POL for GPIO %d", __func__, nGpio);
+    return UGPIOINT_ERROR;
+  }
+
+  eHALResult = HAL_tlmmtile_Set(
+                 nGpio, HAL_TLMMTILE_REG_INTRCFG,
+                 HAL_TLMMTILE_FIELD_INTRCFG_DIRCONNEN, 1);
+  if (HALTLMMTILE_ERR == eHALResult)
+  {
+    uGPIOIntInternal_Log(
+      1, "%s: FAIL. Could not set DIRCONNEN for GPIO %d", __func__, nGpio);
+    return UGPIOINT_ERROR;
+  }
+
+  uGPIOIntDirConnSlots[nIdx].nGpio   = (uint16_t)nGpio;
+  uGPIOIntDirConnSlots[nIdx].bActive = 1;
+
+  if (pnInt)
+  {
+    *pnInt = uGPIOIntDirConnSlots[nIdx].nInt;
+  }
+
+  uGPIOIntInternal_Log(
+    2, "%s: SUCCESS. GPIO %d on DIR_CONN slot %d, interrupt %d, trigger %d",
+    __func__, nGpio, nIdx, uGPIOIntDirConnSlots[nIdx].nInt, eTrigger);
+
+  return UGPIOINT_SUCCESS;
+}
+
+/* =============================================================================
+**  Function : uGPIOIntInternal_DirConnUnconfig
+** ===========================================================================*/
+/**
+  [CQ8750s] Goertek: releases a TLMM direct-connect slot previously
+  configured for nGpio.
+
+  @param[in]  nGpio   GPIO number
+
+  @return
+  None.
+
+  @dependencies
+  None.
+*/
+
+static void uGPIOIntInternal_DirConnUnconfig
+(
+  uint32_t nGpio
+)
+{
+  uint32_t nIdx;
+
+  for (nIdx = 0; nIdx < UGPIOINT_DIRCONN_SLOTS; nIdx++)
+  {
+    if (uGPIOIntDirConnSlots[nIdx].bActive &&
+        uGPIOIntDirConnSlots[nIdx].nGpio == (uint16_t)nGpio)
+    {
+      break;
+    }
+  }
+  if (nIdx >= UGPIOINT_DIRCONN_SLOTS)
+  {
+    return;
+  }
+
+  HAL_tlmmtile_Set(
+    nGpio, HAL_TLMMTILE_REG_INTRCFG,
+    HAL_TLMMTILE_FIELD_INTRCFG_DIRCONNEN, 0);
+  HAL_tlmmtile_SetDirConn(
+    nIdx, HAL_TLMMTILE_FIELD_DIRCONNINTRCFG_SEL, 0);
+
+  uGPIOIntDirConnSlots[nIdx].bActive = 0;
+  uGPIOIntDirConnSlots[nIdx].nGpio   = UGPIOINT_NONE;
+}
+
